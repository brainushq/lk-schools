{
  "name": "@brainus/lk-schools-api",
  "version": "0.2.0",
  "private": true,
  "description": "Search API for the lk-schools dataset, deployed as a Cloudflare Worker.",
  "type": "module",
  "scripts": {
    "sync-data": "node ../../scripts/sync-data.mjs api api-assets",
    "dev": "npm run sync-data && wrangler dev",
    "deploy": "npm run sync-data && wrangler deploy",
    "typecheck": "npm run sync-data && tsc --noEmit",
    "test": "npm run sync-data && node --test --experimental-strip-types test/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.149.0"
  }
}
